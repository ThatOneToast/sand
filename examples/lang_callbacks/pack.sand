//! A player's selected message formatter keeps a snapshot of their preference.
#![pack(namespace = "reward_notes", minecraft = "26.2")]

player state Notes {
    format: fn(number) -> string,
    points: number
}

fn style(prefix: string) -> fn(number) -> string {
    return move |points: number| -> string {
        return prefix + points.to_string();
    };
}

#[on(join)]
fn setup() {
    let name = "Mining points: ";
    Notes.format = style(name);
}

#[on(mine_block = Block::Stone)]
fn mine() {
    Notes.points += 1;
    let render = Notes.format;
    chat!(render(Notes.points));
}
