#![pack(namespace = "scout_checkpoints", minecraft = "26.2", description = "Save and revisit a camp checkpoint")]

use spatial::Position;
use time::Duration;

player state Camp {
    saved: bool,
    checkpoint: Position,
    cooldown: timer,
}

#[on(first_join)]
fn equip_scout() {
    give_item(Item::CarrotOnAStick);
    chat!("Use the checkpoint tool while sneaking to save your spot.");
}

#[on(use_item = Item::CarrotOnAStick)]
fn use_checkpoint() {
    if is_sneaking() {
        if !dimension_is(Dimension::Overworld) {
            actionbar!("Save your checkpoint in the Overworld.");
            return;
        }
        Camp.checkpoint = Position::player();
        Camp.saved = true;
        actionbar!("Checkpoint saved.");
        return;
    }

    if !Camp.saved || !dimension_is(Dimension::Overworld) {
        actionbar!("Save an Overworld checkpoint before returning to it.");
        return;
    }
    if timer_running(Camp.cooldown) {
        actionbar!("Checkpoint travel is cooling down.");
        return;
    }
    let recovery = Duration::from_seconds(5);
    start_timer(Camp.cooldown, ticks = recovery.as_ticks());
    Camp.checkpoint.teleport();
}
