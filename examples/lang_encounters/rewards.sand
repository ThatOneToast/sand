//! Rewards granted by the world clock.

use crate::Hero;

/// Restore some energy to the current player.
pub fn grant() {
    Hero.energy += 25;
    play_sound(Sound::EntityExperienceOrbPickup);
    if Hero.phase == crate::Phase::Resting {
        Hero.phase = crate::Phase::Idle;
    }
}

/// An amethyst Sentry trim for any trimmable armor.
recipe GuardTrim {
    smithing_trim: Item::SentryArmorTrimSmithingTemplate,
    base: "#minecraft:trimmable_armor",
    addition: Item::AmethystShard,
    trim_pattern: "minecraft:sentry",
}
