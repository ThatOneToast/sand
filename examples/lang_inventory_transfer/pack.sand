#![pack(namespace = "camp_supplies", minecraft = "26.2", description = "Sort camp supplies")]

inventory_transfer PackSupplies {
    from: 0,
    to: 9,
    amount: 2,
    success: packed,
    rejected: no_room,
}

pub fn stow() {
    transfer_inventory(PackSupplies);
}

fn packed() {
    actionbar!("{green}Packed two items");
}

fn no_room() {
    actionbar!("{red}Check the source stack and destination slot");
}
