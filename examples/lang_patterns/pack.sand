//! A per-player mining streak with typed reward matches and owned destructuring.
#![pack(namespace = "mining_streak", minecraft = "26.2")]
enum Rank { Beginner, Explorer, Veteran }
struct Reward { title: string, amounts: [number; 2] }
player state Progress { mined: number }
fn reward(rank: Rank) -> Reward {
    return match rank {
        Rank::Beginner => Reward { title: "First steps", amounts: [1, 0] },
        Rank::Explorer => Reward { title: "Explorer", amounts: [2, 1] },
        Rank::Veteran => Reward { title: "Veteran", amounts: [4, 2] },
    };
}
#[on(mine_block = Block::Stone)]
fn mine() {
    Progress.mined += 1;
    if Progress.mined % 10 == 0 {
        let rank = match Progress.mined {
            10 | 20 => Rank::Beginner,
            _ if Progress.mined <= 40 => Rank::Explorer,
            _ => Rank::Veteran,
        };
        match reward(rank) {
            let Reward { title, amounts: [iron, gold] } if gold > 0 => {
                give_item(Item::IronIngot, count = iron);
                give_item(Item::GoldIngot, count = gold);
                chat!("{gold}{title}{reset}: mined {Progress.mined} stone!");
            }
            let Reward { title, amounts: [iron, _] } => {
                give_item(Item::IronIngot, count = iron);
                chat!("{gold}{title}{reset}: mined {Progress.mined} stone!");
            }
        }
    }
}
