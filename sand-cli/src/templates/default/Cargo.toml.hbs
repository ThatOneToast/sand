[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"

[lib]
name = "{{name_snake}}"
path = "src/lib.rs"

[[bin]]
name = "sand_export"
path = "src/bin/sand_export.rs"

[dependencies]
{{#if use_path_deps}}
sand = { path = "{{sand_path}}" }
{{else}}
sand = { git = "{{sand_git_url}}", branch = "main" }
{{/if}}

[build-dependencies]
{{#if use_path_deps}}
sand-build = { path = "{{sand_build_path}}" }
{{else}}
sand-build = { git = "{{sand_git_url}}", branch = "main" }
{{/if}}
