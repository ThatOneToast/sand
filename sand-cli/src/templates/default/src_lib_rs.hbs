//! # {{name}}
//!
//! A Minecraft {{mc_version}} datapack built with [Sand](https://github.com/ThatOneToast/sand).

use sand::events::OnJoinEvent;
use sand::prelude::*;

// -- State ------------------------------------------------------------------

static PLAYER_DATA: StorageVar<i32> = StorageVar::new("{{namespace}}:data", "player.mana");

// -- Functions -------------------------------------------------------------

/// Sends a welcome message to the joining player.
///
/// Automatically written to `data/{{namespace}}/function/hello_world.mcfunction`
/// by `sand build`. Called from `on_join` below via a typed function
/// reference (`cmd::call`), and callable directly with `/function {{namespace}}:hello_world`.
#[function]
pub fn hello_world() {
    cmd::tellraw(
        Target::self_(),
        Text::new("Welcome to {{name}}!").gold().bold(true),
    );
}

// -- Events ------------------------------------------------------------------

/// Runs `hello_world` for a player on the first tick after each server
/// start/reload, and for any new player who joins mid-session.
///
/// `OnJoinEvent` is Sand's built-in join event — `#[on_event]` generates the
/// scoreboard-backed detection and per-player dispatch automatically; no
/// hand-written advancement or tick component is needed. Vanilla
/// limitation: a mid-session disconnect/reconnect does not re-fire this
/// event, because the join flag persists in `scoreboard.dat` (see
/// `sand::events::OnJoinEvent`'s docs). For a "first time ever" welcome
/// instead, use `Event<FirstJoinEvent>`. See `sand::events` for the
/// full built-in event list (deaths, respawns, item use, block placement,
/// and more).
#[on_event]
pub fn on_join(event: Event<OnJoinEvent>) {
    let _ = event;
    cmd::call(hello_world);
}

// -- Datapack export hook -- required by `sand build`, do not remove -------

/// Invoked by the generated `sand_export` binary.
///
/// Calling this function from the binary forces the linker to include this
/// library's object file, which is required for `inventory::submit!`
/// constructor functions to run before `main`.
///
/// If you add components in separate modules, re-export them here with
/// `pub use my_module::*;` to ensure they are also linked.
#[doc(hidden)]
pub fn __sand_export(namespace: &str, mc_version: &str) {
    match sand::advanced::try_export_components_json(namespace, mc_version) {
        Ok(json) => println!("{json}"),
        Err(e) => {
            eprintln!("sand export failed: {e}");
            std::process::exit(1);
        }
    }
}
