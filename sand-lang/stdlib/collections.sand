//! Owned, insertion-ordered collections built from Sand's typed vectors.
/// One independent key/value pair returned by Map.entries().
pub struct Entry<K, V> {
    pub key: K,
    pub value: V
}
/// A bounded map with exact typed key equality and independent owned values.
pub struct Map<K, V> {
    items: Vec<Entry<K, V>>
}
impl<K, V>Map<K, V> {
    pub fn new() -> Self {
        return Self {
            items: []
        };
    }
    pub fn len(&self) -> number {
        return self.items.len();
    }
    pub fn is_empty(&self) -> bool {
        return self.items.is_empty();
    }
    pub fn contains_key(&self, key: K) -> bool {
        for entry in self.items {
            if entry.key == key {
                return true;
            }
        }
        return false;
    }
    pub fn get_or(&self, key: K, fallback: V) -> V {
        for entry in self.items {
            if entry.key == key {
                return entry.value;
            }
        }
        return fallback;
    }
    /// Insert or replace a value. False means a new key would exceed capacity.
    pub fn insert(&mut self, key: K, value: V) -> bool {
        for i in 0..self.items.len() {
            if self.items[i].key == key {
                self.items[i].value = value;
                return true;
            }
        }
        return self.items.push(Entry {
            key,
            value
        });
    }
    pub fn remove(&mut self, key: K) -> bool {
        for i in 0..self.items.len() {
            if self.items[i].key == key {
                self.items.remove_or(i, self.items[i]);
                return true;
            }
        }
        return false;
    }
    pub fn remove_or(&mut self, key: K, fallback: V) -> V {
        for i in 0..self.items.len() {
            if self.items[i].key == key {
                let entry = self.items.remove_or(i, self.items[i]);
                return entry.value;
            }
        }
        return fallback;
    }
    pub fn clear(&mut self) {
        self.items.clear();
    }
    pub fn keys(&self) -> Vec<K> {
        let mut keys: Vec<K>;
        for entry in self.items {
            keys.push(entry.key);
        }
        return keys;
    }
    pub fn values(&self) -> Vec<V> {
        let mut values: Vec<V>;
        for entry in self.items {
            values.push(entry.value);
        }
        return values;
    }
    pub fn entries(&self) -> Vec<Entry<K, V>> {
        return self.items;
    }
}
/// A bounded set that preserves insertion order and compares whole owned values.
pub struct Set<T> {
    items: Vec<T>
}
impl<T>Set<T> {
    pub fn new() -> Self {
        return Self {
            items: []
        };
    }
    pub fn len(&self) -> number {
        return self.items.len();
    }
    pub fn is_empty(&self) -> bool {
        return self.items.is_empty();
    }
    pub fn contains(&self, value: T) -> bool {
        return self.items.contains(value);
    }
    /// True only when a new value was added; duplicates and full sets return false.
    pub fn insert(&mut self, value: T) -> bool {
        if self.items.contains(value) {
            return false;
        }
        return self.items.push(value);
    }
    pub fn remove(&mut self, value: T) -> bool {
        for i in 0..self.items.len() {
            if self.items[i] == value {
                self.items.remove_or(i, self.items[i]);
                return true;
            }
        }
        return false;
    }
    pub fn clear(&mut self) {
        self.items.clear();
    }
    pub fn values(&self) -> Vec<T> {
        return self.items;
    }
}
