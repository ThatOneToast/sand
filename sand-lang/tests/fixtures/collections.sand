#![pack(namespace = "language_probe", minecraft = "26.2")]
const SIZE: number = 3;
struct Node { x: number }
impl Node {
    fn add(&mut self, n: number) -> number { Result.calls += 1; self.x += n; return self.x; }
}
global state Data { values: [number; SIZE] = [1, 2, 3], nodes: [Node; 2] }
global state Result { checks: number, failed: number, order: number, calls: number }
fn check(actual: number, expected: number) { Result.checks += 1; if actual != expected { Result.failed += 1; } }
fn index() -> number { Result.order += 1; return 1; }
fn next() -> number { Result.order += 1; return Result.order; }
fn rotate(values: [number; 3], n: number) -> [number; 3] {
    if n == 0 { return values; }
    return rotate([values[1], values[2], values[0]], n - 1);
}
fn run() {
    Result.checks = 0; Result.failed = 0; Result.order = 0; Result.calls = 0;
    Data.values = [1, 2, 3];
    check(Data.values.len(), 3);
    let mut copied = Data.values;
    let i = 1;
    copied[i] += 5;
    check(copied[i], 7); check(Data.values[i], 2);
    check(copied.contains(7) as number, 1);
    check(copied.contains(8) as number, 0);
    check(copied.get_or(-1, 99), 99);
    check(copied.get_or(2, 99), 3);
    let bad = 99;
    check(copied[bad], 0);
    copied[bad] = 100;
    check(copied[1], 7);
    Data.values = rotate(copied, 4);
    check(Data.values[0], 7); check(Data.values[1], 3); check(Data.values[2], 1);
    copied.fill(next());
    check(Result.order, 1);
    check(copied[0], 1); check(copied[2], 1);
    Data.nodes = [Node { x: 2 }, Node { x: 3 }];
    Result.order = 0;
    let changed = Data.nodes[index()].add(5);
    check(Result.order, 1); check(changed, 8); check(Data.nodes[1].x, 8);
    let skipped = Data.nodes[bad].add(5);
    check(skipped, 0); check(Result.calls, 1);
    Data.nodes[bad].x = 42;
    check(Data.nodes[0].x, 2); check(Data.nodes[1].x, 8);
    let node = Data.nodes.get_or(bad, Node { x: 15 });
    check(node.x, 15);
    check(Data.nodes.contains(Node { x: 8 }) as number, 1);
    let empty: [number; 0] = [];
    check(empty.len(), 0); check(empty.is_empty() as number, 1);
    check(empty.contains(1) as number, 0);
    check(empty.get_or(0, 25), 25);
    let mut grid: [[float; 2]; 2] = [[1.0, 2.0], [3.0, 4.0]];
    grid[i][0] *= 1.5;
    check((grid[1][0] * 1000.0) as number, 4500);
    Data.values = [1, 2, 3];
    let mut total = 0;
    for value in Data.values { total += value; Data.values.fill(9); }
    check(total, 6); check(Data.values[0], 9);
    total = 0;
    for value in [1, 2, 3, 4] { if value == 2 { continue; } if value == 4 { break; } total += value; }
    check(total, 4);
    let values = [2, 3];
    total = 0;
    for values in values { total += values; }
    check(total, 5);
    total = 0;
    for row in [[1, 2], [3, 4]] { for value in row { total += value; } }
    check(total, 10);
    Result.order = 0;
    let repeated = [next(); SIZE];
    check(Result.order, 1); check(repeated[2], 1);
    let mut nodes = [Node { x: 1 }; 2];
    nodes[0].add(3);
    check(nodes[0].x, 4); check(nodes[1].x, 1);
    Result.order = 0;
    let nothing = [next(); 0];
    check(Result.order, 1); check(nothing.len(), 0);
    if Result.checks == 40 && Result.failed == 0 { raw!("say __SAND_LANGUAGE_OK__"); }
    else { raw!("say __SAND_LANGUAGE_FAILED__"); }
}
