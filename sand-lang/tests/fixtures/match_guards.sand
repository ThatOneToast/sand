#![pack(namespace = "language_probe", minecraft = "26.2")]

global state Report { checks: number, failed: number, calls: number, selected: number }

fn check(value: bool) {
    Report.checks += 1;
    if !value { Report.failed += 1; }
}

fn test_guard(value: bool) -> bool {
    Report.calls += 1;
    return value;
}

fn pick(value: number) -> number {
    return match value {
        4 if test_guard(true) => 40,
        3 if test_guard(false) => 30,
        1 | 3 if test_guard(true) => 20,
        3 if test_guard(true) => 99,
        _ => 0,
    };
}

fn recursive(value: number) -> number {
    return match value {
        0 => 1,
        _ if recursive(value - 1) == value => value + 1,
        _ => 0,
    };
}

fn run() {
    Report.checks = 0;
    Report.failed = 0;
    Report.calls = 0;
    check(pick(3) == 20);
    check(Report.calls == 2);
    check(pick(4) == 40);
    check(Report.calls == 3);
    check(pick(7) == 0);
    check(Report.calls == 3);
    check(recursive(3) == 4);

    Report.selected = 0;
    let permit = false;
    match 8 {
        _ if permit && test_guard(true) => { Report.selected = 10; }
        8 if test_guard(false) => { Report.selected = 11; }
        8 => { Report.selected = 12; }
        _ => { Report.selected = 13; }
    }
    check(Report.selected == 12);
    check(Report.calls == 4);
    check(match true { _ if test_guard(false) => 1, false => 2, true => 3 } == 3);
    check(Report.calls == 5);

    if Report.checks == 11 && Report.failed == 0 { raw!("say __SAND_LANGUAGE_OK__"); }
    else { raw!("say __SAND_LANGUAGE_FAILED__"); }
}
