//! Imported by the two-client runtime probe.
use crate::collections::{Map, Set};

player state Journal {
    notes: Map<string, Vec<string>>,
    visited: Set<string>,
    describe: fn(number) -> string
}

fn describe_prefix(prefix: string) -> fn(number) -> string {
    return move |value: number| -> string { return prefix + value.to_string(); };
}

pub fn store_a() {
    Journal.notes.insert("today", ["A", "🌍"]);
    Journal.visited.insert("overworld");
    Journal.describe = describe_prefix("A/");
}

pub fn store_b() {
    Journal.notes.insert("today", ["B"]);
    Journal.visited.insert("nether");
    Journal.describe = describe_prefix("B/");
}

pub fn check_a() {
    let describe = Journal.describe;
    if Journal.notes.get_or("today", []) == ["A", "🌍"]
        && Journal.visited.values() == ["overworld"] && describe(1) == "A/1" {
        raw!("scoreboard players set #maps_a numeric_probe 1");
    }
}

pub fn check_b() {
    let describe = Journal.describe;
    if Journal.notes.get_or("today", []) == ["B"]
        && Journal.visited.values() == ["nether"] && describe(2) == "B/2" {
        raw!("scoreboard players set #maps_b numeric_probe 1");
    }
}
