//! Imported by the two-client runtime probe.
struct Plan { label: string, boost: number, steps: Vec<number> }
player state Ledger { stage_one: number, stage_two: number, cancelled: number }

fn run(plan: Plan) {
    let mut amount = plan.boost;
    wait(12);
    amount += plan.steps[0];
    Ledger.stage_one += amount;

    wait(4);
    if plan.label == "A" || plan.label == "A2" || plan.label == "B🌍" {
        Ledger.stage_two += amount + plan.steps[1];
        raw!("execute if dimension minecraft:overworld run scoreboard players add @s wait_origin 1");
        if plan.label == "A" { raw!("say __SAND_WAIT_A_DONE__"); }
        if plan.label == "A2" { raw!("say __SAND_WAIT_A2_DONE__"); }
        if plan.label == "B🌍" { raw!("say __SAND_WAIT_B_DONE__"); }
    }
}

pub fn queue_a() {
    run(Plan { label: "A", boost: 2, steps: [1, 7] });
    run(Plan { label: "A2", boost: 4, steps: [3, 8] });
}

pub fn queue_b() {
    run(Plan { label: "B🌍", boost: 4, steps: [1, 6] });
}

pub fn cancel() { cancel_waits(); }

pub fn queue_cancellable() {
    wait(12);
    Ledger.cancelled += 1;
    raw!("say __SAND_WAIT_CANCELLABLE_DONE__");
}

pub fn check_a() {
    if Ledger.stage_one == 10 && Ledger.stage_two == 25 && Ledger.cancelled == 0 {
        raw!("scoreboard players set #wait_a numeric_probe 1");
    }
}

pub fn check_b() {
    if Ledger.stage_one == 5 && Ledger.stage_two == 11 && Ledger.cancelled == 1 {
        raw!("scoreboard players set #wait_b numeric_probe 1");
    }
}
