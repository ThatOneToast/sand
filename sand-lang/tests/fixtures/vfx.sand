#![pack(namespace = "vfx_probe", minecraft = "26.2")]

vfx Flourish {
    cues: [
        { particle: Particle::HappyVillager, points: [[-0.5, 1.0, 0.0], [0.5, 1.0, 0.0]], count: 4 },
        { sound: Sound::EntityPlayerLevelup, volume: 0.75, pitch: 1.25 },
        { particle: Particle::Heart, force: true, spread: [0.25, 0.0, 0.25], speed: 0.1 },
    ],
}

pub fn perform() { play_vfx(Flourish); }
