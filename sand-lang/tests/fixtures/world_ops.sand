#![pack(namespace = "language_probe", minecraft = "26.2")]

global state Report { checks: number, failed: number }

fn check(value: bool) {
    Report.checks += 1;
    if !value {
        Report.failed += 1;
        broadcast!("World assertion {Report.checks} failed.");
    }
}
fn check_end() { check(dimension_is(Dimension::TheEnd)); }
fn check_nether() {
    check(dimension_is(Dimension::TheNether));
    in_dimension(Dimension::TheEnd, check_end);
    check(dimension_is(Dimension::TheNether));
}

fn run() {
    Report.checks = 0;
    Report.failed = 0;
    check(dimension_is(Dimension::Overworld));
    in_dimension(Dimension::TheNether, check_nether);
    check(dimension_is(Dimension::Overworld));

    raw!("fillbiome 0 68 0 15 95 15 minecraft:plains");
    check(biome_is(Biome::Plains, pos(8, 80, 8)));
    check(!biome_is(Biome::Desert, pos(8, 80, 8)));
    fill_blocks(Block::Air, pos(0, 79, 0), pos(15, 83, 3));
    set_block(Block::Stone, pos(1, 80, 1));
    set_block(Block::Air, pos(2, 80, 1));
    set_block(Block::GoldBlock, pos(3, 80, 1));
    set_block(Block::Dirt, pos(6, 80, 1));
    clone_blocks(pos(1, 80, 1), pos(3, 80, 1), pos(5, 80, 1), masked = true);
    check(block_is(Block::Stone, pos(5, 80, 1)));
    check(block_is(Block::Dirt, pos(6, 80, 1)));
    check(block_is(Block::GoldBlock, pos(7, 80, 1)));

    set_block(Block::Air, pos(12, 80, 1));
    clone_blocks(pos(1, 80, 1), pos(3, 80, 1), pos(10, 80, 1), filter = Block::GoldBlock, mode = CloneMode::Move);
    check(block_is(Block::Stone, pos(1, 80, 1)));
    check(block_is(Block::Air, pos(3, 80, 1)));
    check(block_is(Block::GoldBlock, pos(12, 80, 1)));
    set_block(Block::Barrel, pos(14, 80, 1));
    raw!("item replace block 14 80 1 container.0 with minecraft:bread 1");
    let count = block_data_number(pos(14, 80, 1), "Items[0].count");
    check(count == 1);
    set_block_data(pos(14, 80, 1), "Items[0].count", count + 4);
    check(block_data_number(pos(14, 80, 1), "Items[0].count") == 5);
    set_block_data(pos(14, 80, 1), "Items[0].count", 9);
    check(block_data_number(pos(14, 80, 1), "Items[0].count") == 9);
    remove_block_data(pos(14, 80, 1), "Items[0]");
    check(block_data_number(pos(14, 80, 1), "Items") == 0);
    check(block_data_number(pos(14, 80, 1), "Items[0].count") == 0);
    set_block_data(pos(14, 80, 1), "Items", [
        Nbt { Slot: false, id: "minecraft:bread", count: 3 }
    ]);
    check(block_data_number(pos(14, 80, 1), "Items[0].count") == 3);
    set_block(Block::Barrel, pos(15, 80, 1));
    copy_block_data(pos(14, 80, 1), "Items", pos(15, 80, 1), "Items");
    check(block_data_number(pos(15, 80, 1), "Items[0].count") == 3);
    set_block_data(pos(14, 80, 1), "Items[0].count", 7);
    check(block_data_number(pos(14, 80, 1), "Items[0].count") == 7
        && block_data_number(pos(15, 80, 1), "Items[0].count") == 3);
    set_block_data(pos(15, 80, 1), "CustomName", "Supply cache");
    check(block_data_number(pos(15, 80, 1), "CustomName") > 0);
    remove_block_data(pos(15, 80, 1), "Items");
    copy_block_data(pos(15, 80, 1), "Items[0]", pos(14, 80, 1), "Items[0]");
    check(block_data_number(pos(14, 80, 1), "Items[0].count") == 7);
    if Report.checks == 23 && Report.failed == 0 { raw!("say __SAND_LANGUAGE_OK__"); }
    else { raw!("say __SAND_LANGUAGE_FAILED__"); }
}
