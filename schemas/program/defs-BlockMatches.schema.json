{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A test that a block matches at a position.",
  "properties": {
    "at": {
      "$ref": "defs-BlockPosition.schema.json",
      "description": "Tested position."
    },
    "block": {
      "description": "Block identity, or `#tag`.",
      "type": "string"
    }
  },
  "required": [
    "block",
    "at"
  ],
  "type": "object"
}
