{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit live and saved player State fields in one checkpoint projection.",
  "properties": {
    "live": {
      "$ref": "defs-FieldReference.schema.json",
      "description": "The live gameplay field."
    },
    "saved": {
      "$ref": "defs-FieldReference.schema.json",
      "description": "The saved copy in the checkpoint State."
    }
  },
  "required": [
    "live",
    "saved"
  ],
  "type": "object"
}
