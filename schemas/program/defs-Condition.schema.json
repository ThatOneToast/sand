{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "defs-ScoreComparison.schema.json",
      "description": "The field lies within inclusive constant bounds."
    },
    {
      "$ref": "defs-ScoreRelation.schema.json",
      "description": "Two fields satisfy a relation."
    },
    {
      "$ref": "defs-StateAttached.schema.json",
      "description": "The executor has an entity State attached."
    },
    {
      "$ref": "defs-EntitiesExist.schema.json",
      "description": "At least one entity matches."
    },
    {
      "$ref": "defs-BlockMatches.schema.json",
      "description": "A block matches at a position."
    },
    {
      "$ref": "defs-DimensionMatches.schema.json",
      "description": "The current command execution dimension matches."
    },
    {
      "$ref": "defs-BiomeMatches.schema.json",
      "description": "A biome matches at a block position."
    },
    {
      "$ref": "defs-ItemHeld.schema.json",
      "description": "The executor holds an item."
    },
    {
      "$ref": "defs-FlagSet.schema.json",
      "description": "The executor has an entity flag."
    },
    {
      "description": "A native predicate evaluated in the current execution context.",
      "properties": {
        "predicate": {
          "type": "string"
        }
      },
      "required": [
        "predicate"
      ],
      "type": "object"
    },
    {
      "description": "Test the current player's committed completion index.",
      "properties": {
        "progression_completed": {
          "type": "string"
        }
      },
      "required": [
        "progression_completed"
      ],
      "type": "object"
    },
    {
      "description": "Match the current player's advancement or named criterion completion.",
      "properties": {
        "advancement": {
          "type": "string"
        },
        "criterion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "advancement"
      ],
      "type": "object"
    }
  ],
  "description": "A portable condition evaluated with the current executor and position."
}
