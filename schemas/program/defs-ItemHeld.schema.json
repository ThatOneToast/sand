{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A test that the executor holds an item.",
  "properties": {
    "holding": {
      "description": "Vanilla or custom item identity.",
      "type": "string"
    },
    "offhand": {
      "description": "Test the off hand instead of the main hand.",
      "type": "boolean"
    }
  },
  "required": [
    "holding"
  ],
  "type": "object"
}
