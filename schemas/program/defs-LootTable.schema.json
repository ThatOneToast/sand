{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A loot table: rolls drawn from weighted item choices.",
  "properties": {
    "id": {
      "description": "Identity.",
      "type": "string"
    },
    "items": {
      "description": "Weighted item choices.",
      "items": {
        "$ref": "defs-LootItem.schema.json"
      },
      "type": "array"
    },
    "rolls": {
      "default": 1,
      "description": "Choices drawn each time.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "items"
  ],
  "type": "object"
}
