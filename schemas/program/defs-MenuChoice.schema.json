{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A native menu button and the gameplay function it invokes.",
  "properties": {
    "action": {
      "anyOf": [
        {
          "$ref": "defs-FunctionReference.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Function invoked with the choosing player as executor."
    },
    "label": {
      "description": "Label shown on the button.",
      "items": {
        "$ref": "defs-TextPart.schema.json"
      },
      "type": "array"
    },
    "next": {
      "description": "View to open after the optional callback completes.",
      "type": [
        "string",
        "null"
      ]
    },
    "when": {
      "anyOf": [
        {
          "$ref": "defs-FieldReference.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "When present, the referenced score must equal one to authorize the choice."
    }
  },
  "required": [
    "label"
  ],
  "type": "object"
}
