{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One named owner of declarations and ordered lifecycle contributions.",
  "properties": {
    "abilities": {
      "description": "Owned activations and their State-backed admission policies.",
      "items": {
        "$ref": "defs-AbilityDefinition.schema.json"
      },
      "type": "array"
    },
    "advancements": {
      "description": "Native advancements declared by this module.",
      "items": {
        "$ref": "defs-Advancement.schema.json"
      },
      "type": "array"
    },
    "biomes": {
      "description": "Native custom biomes declared by this module.",
      "items": {
        "$ref": "defs-CustomBiome.schema.json"
      },
      "type": "array"
    },
    "boss_bars": {
      "description": "Boss bars, created at load.",
      "items": {
        "$ref": "defs-BossBar.schema.json"
      },
      "type": "array"
    },
    "checkpoints": {
      "description": "Player-owned State checkpoint definitions.",
      "items": {
        "$ref": "defs-CheckpointDefinition.schema.json"
      },
      "type": "array"
    },
    "combats": {
      "description": "Named State combat policies.",
      "items": {
        "$ref": "defs-CombatDefinition.schema.json"
      },
      "type": "array"
    },
    "damage_types": {
      "description": "Native damage type definitions.",
      "items": {
        "$ref": "defs-DamageType.schema.json"
      },
      "type": "array"
    },
    "dialogs": {
      "description": "Native notice dialogs declared by this module.",
      "items": {
        "$ref": "defs-NoticeDialog.schema.json"
      },
      "type": "array"
    },
    "dimension_types": {
      "description": "Native dimension type components, referenced by dimensions.",
      "items": {
        "$ref": "defs-DimensionType.schema.json"
      },
      "type": "array"
    },
    "dimensions": {
      "description": "Native dimensions declared by this module.",
      "items": {
        "$ref": "defs-DimensionDefinition.schema.json"
      },
      "type": "array"
    },
    "encounters": {
      "description": "Player-owned priority encounter definitions.",
      "items": {
        "$ref": "defs-EncounterDefinition.schema.json"
      },
      "type": "array"
    },
    "events": {
      "description": "Player event handlers, dispatched in declaration order.",
      "items": {
        "$ref": "defs-EventHook.schema.json"
      },
      "type": "array"
    },
    "flows": {
      "description": "Gameplay state machines owned by this module.",
      "items": {
        "$ref": "defs-Flow.schema.json"
      },
      "type": "array"
    },
    "functions": {
      "description": "Named functions, including declarations unreachable from tags.",
      "items": {
        "$ref": "defs-Function.schema.json"
      },
      "type": "array"
    },
    "huds": {
      "description": "Named owner-scoped HUD definitions.",
      "items": {
        "$ref": "defs-HudDefinition.schema.json"
      },
      "type": "array"
    },
    "id": {
      "description": "Explicit semantic identity, independent of source filename.",
      "type": "string"
    },
    "inventory_transfers": {
      "description": "Named inventory transfer definitions owned by this module.",
      "items": {
        "$ref": "defs-InventoryTransferDefinition.schema.json"
      },
      "type": "array"
    },
    "items": {
      "description": "Custom items that operations and recipes refer to by id.",
      "items": {
        "$ref": "defs-CustomItem.schema.json"
      },
      "type": "array"
    },
    "jobs": {
      "description": "Player-owned bounded indexed work.",
      "items": {
        "$ref": "defs-JobDefinition.schema.json"
      },
      "type": "array"
    },
    "load": {
      "description": "Server-context bodies run at load in authored order.",
      "items": {
        "$ref": "defs-Operation.schema.json"
      },
      "type": "array"
    },
    "loot_tables": {
      "description": "Loot tables.",
      "items": {
        "$ref": "defs-LootTable.schema.json"
      },
      "type": "array"
    },
    "menus": {
      "description": "Native menus with bounded sessions and ordered choices.",
      "items": {
        "$ref": "defs-MenuDefinition.schema.json"
      },
      "type": "array"
    },
    "ore_features": {
      "description": "Configured ore veins and their biome-restricted placement.",
      "items": {
        "$ref": "defs-OreFeatureDefinition.schema.json"
      },
      "type": "array"
    },
    "predicates": {
      "description": "Reusable native world predicates.",
      "items": {
        "$ref": "defs-WorldPredicate.schema.json"
      },
      "type": "array"
    },
    "progressions": {
      "description": "Player progression tracks.",
      "items": {
        "$ref": "defs-ProgressionDefinition.schema.json"
      },
      "type": "array"
    },
    "projectiles": {
      "description": "Projectiles launched and cancelled by the owning player.",
      "items": {
        "$ref": "defs-ProjectileDefinition.schema.json"
      },
      "type": "array"
    },
    "recipes": {
      "description": "Crafting, cooking, and stonecutting recipes.",
      "items": {
        "$ref": "defs-Recipe.schema.json"
      },
      "type": "array"
    },
    "resource_tags": {
      "description": "Item, block, and entity-type tags.",
      "items": {
        "$ref": "defs-ResourceTag.schema.json"
      },
      "type": "array"
    },
    "scenes": {
      "description": "Owned native display scenes.",
      "items": {
        "$ref": "defs-SceneDefinition.schema.json"
      },
      "type": "array"
    },
    "sessions": {
      "description": "Owned session controllers over named tracks.",
      "items": {
        "$ref": "defs-SessionDefinition.schema.json"
      },
      "type": "array"
    },
    "states": {
      "description": "Player or global State definitions owned by this module.",
      "items": {
        "$ref": "defs-State.schema.json"
      },
      "type": "array"
    },
    "structure_sets": {
      "description": "Native placements for weighted structures.",
      "items": {
        "$ref": "defs-StructureSet.schema.json"
      },
      "type": "array"
    },
    "structure_templates": {
      "description": "Native templates whose bytes are supplied in the envelope.",
      "items": {
        "$ref": "defs-StructureTemplate.schema.json"
      },
      "type": "array"
    },
    "tags": {
      "description": "Typed function-tag membership.",
      "items": {
        "$ref": "defs-TagMembership.schema.json"
      },
      "type": "array"
    },
    "tick": {
      "description": "Server-context bodies run each tick in authored order.",
      "items": {
        "$ref": "defs-Operation.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "id"
  ],
  "type": "object"
}
