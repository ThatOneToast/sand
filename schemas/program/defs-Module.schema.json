{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One named owner of declarations and ordered lifecycle contributions.",
  "properties": {
    "boss_bars": {
      "description": "Boss bars, created at load.",
      "items": {
        "$ref": "defs-BossBar.schema.json"
      },
      "type": "array"
    },
    "events": {
      "description": "Player event handlers, dispatched in declaration order.",
      "items": {
        "$ref": "defs-EventHook.schema.json"
      },
      "type": "array"
    },
    "flows": {
      "description": "Gameplay state machines owned by this module.",
      "items": {
        "$ref": "defs-Flow.schema.json"
      },
      "type": "array"
    },
    "functions": {
      "description": "Named functions, including declarations unreachable from tags.",
      "items": {
        "$ref": "defs-Function.schema.json"
      },
      "type": "array"
    },
    "id": {
      "description": "Explicit semantic identity, independent of source filename.",
      "type": "string"
    },
    "items": {
      "description": "Custom items that operations and recipes refer to by id.",
      "items": {
        "$ref": "defs-CustomItem.schema.json"
      },
      "type": "array"
    },
    "load": {
      "description": "Server-context bodies run at load in authored order.",
      "items": {
        "$ref": "defs-Operation.schema.json"
      },
      "type": "array"
    },
    "loot_tables": {
      "description": "Loot tables.",
      "items": {
        "$ref": "defs-LootTable.schema.json"
      },
      "type": "array"
    },
    "recipes": {
      "description": "Crafting, cooking, and stonecutting recipes.",
      "items": {
        "$ref": "defs-Recipe.schema.json"
      },
      "type": "array"
    },
    "resource_tags": {
      "description": "Item, block, and entity-type tags.",
      "items": {
        "$ref": "defs-ResourceTag.schema.json"
      },
      "type": "array"
    },
    "states": {
      "description": "Player or global State definitions owned by this module.",
      "items": {
        "$ref": "defs-State.schema.json"
      },
      "type": "array"
    },
    "tags": {
      "description": "Typed function-tag membership.",
      "items": {
        "$ref": "defs-TagMembership.schema.json"
      },
      "type": "array"
    },
    "tick": {
      "description": "Server-context bodies run each tick in authored order.",
      "items": {
        "$ref": "defs-Operation.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "id"
  ],
  "type": "object"
}
