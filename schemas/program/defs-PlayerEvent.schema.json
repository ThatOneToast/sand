      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Fires on the observed stop swimming transition.",
      "properties": {
        "kind": {
          "const": "stop_swimming",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Fires on the observed start flying transition.",
      "properties": {
        "kind": {
          "const": "start_flying",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Fires on the observed stop flying transition.",
      "properties": {
        "kind": {
          "const": "stop_flying",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
