        "item": {
          "description": "Used item identity, such as `minecraft:carrot_on_a_stick`.",
          "type": "string"
        },
        "kind": {
          "const": "use_item",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The player jumped.",
      "properties": {
        "kind": {
          "const": "jump",
          "type": "string"
        }
