{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A player occurrence that runs handler functions as that player.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Every join, including the first; observed on the next tick.",
      "properties": {
        "kind": {
          "const": "join",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Only the first time a player ever joins.",
      "properties": {
        "kind": {
          "const": "first_join",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The player died (any cause).",
      "properties": {
        "kind": {
          "const": "death",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The player killed any entity.",
      "properties": {
        "kind": {
          "const": "kill_entity",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The player killed another player.",
      "properties": {
        "kind": {
          "const": "kill_player",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The player used (right-clicked or consumed) an item.",
