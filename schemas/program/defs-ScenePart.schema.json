{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A named visual display and its starting local pose.",
  "properties": {
    "content": {
      "$ref": "defs-SceneContent.schema.json",
      "description": "Native display payload."
    },
    "name": {
      "description": "Name referenced by keyframes within this scene.",
      "type": "string"
    },
    "pose": {
      "$ref": "defs-Transform.schema.json",
      "default": {
        "scale": [
          1.0,
          1.0,
          1.0
        ],
        "translation": [
          0.0,
          0.0,
          0.0
        ],
        "yaw": 0.0
      },
      "description": "Local pose, defaulting to identity."
    }
  },
  "required": [
    "name",
    "content"
  ],
  "type": "object"
}
